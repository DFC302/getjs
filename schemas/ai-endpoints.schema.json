{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getjs.dev/schemas/ai-endpoints.schema.json",
  "title": "getjs AI Endpoint Analysis",
  "description": "Compact, evidence-backed endpoint inventory produced by the optional getjs AI endpoint task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_task",
    "run",
    "target",
    "coverage",
    "evidence",
    "endpoints",
    "graphql_operations",
    "realtime_channels",
    "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "analysis_task": { "type": "string", "const": "endpoints" },
    "run": { "$ref": "#/$defs/run" },
    "target": {
      "type": "string",
      "description": "Target URL or target identifier supplied by getjs."
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "graphql_operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/graphqlOperation" }
    },
    "realtime_channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/realtimeChannel" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "getjs_version",
        "provider",
        "provider_version",
        "model",
        "prompt_source",
        "prompt_sha256",
        "schema_sha256",
        "contains_unredacted_secrets"
      ],
      "properties": {
        "generated_at": { "type": "string" },
        "getjs_version": { "type": "string" },
        "provider": { "type": "string", "enum": ["codex", "claude"] },
        "provider_version": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt_source": { "type": "string" },
        "prompt_sha256": { "type": "string" },
        "schema_sha256": { "type": "string" },
        "contains_unredacted_secrets": { "type": "boolean", "const": true }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_provided",
        "files_analyzed",
        "files_skipped",
        "bytes_provided",
        "bytes_analyzed",
        "complete",
        "notes"
      ],
      "properties": {
        "files_provided": { "type": "integer", "minimum": 0 },
        "files_analyzed": { "type": "array", "items": { "type": "string" } },
        "files_skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "reason"],
            "properties": {
              "file": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "bytes_provided": { "type": "integer", "minimum": 0 },
        "bytes_analyzed": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "source_url",
        "line",
        "column",
        "byte_offset",
        "snippet",
        "explanation"
      ],
      "properties": {
        "id": { "type": "string" },
        "file": { "type": "string" },
        "source_url": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "byte_offset": { "type": ["integer", "null"], "minimum": 0 },
        "snippet": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "location",
        "required",
        "inferred_type",
        "example_or_default",
        "description",
        "evidence_ids"
      ],
      "properties": {
        "name": { "type": "string" },
        "location": {
          "type": "string",
          "enum": [
            "path",
            "query",
            "header",
            "cookie",
            "json_body",
            "form",
            "multipart",
            "graphql_variable",
            "websocket_message",
            "unknown"
          ]
        },
        "required": { "type": ["boolean", "null"] },
        "inferred_type": { "type": ["string", "null"] },
        "example_or_default": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "url_kind",
        "base_url",
        "transport",
        "methods",
        "parameters",
        "request_content_types",
        "headers",
        "authentication",
        "credential_mode",
        "request_body_shape",
        "response_clues",
        "confidence",
        "evidence_ids",
        "notes"
      ],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "url_kind": {
          "type": "string",
          "enum": ["absolute", "relative", "protocol_relative", "template", "dynamic", "unknown"]
        },
        "base_url": { "type": ["string", "null"] },
        "transport": {
          "type": "string",
          "enum": ["http", "graphql", "json_rpc", "soap", "webhook", "telemetry", "other", "unknown"]
        },
        "methods": { "type": "array", "items": { "type": "string" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "request_content_types": { "type": "array", "items": { "type": "string" } },
        "headers": { "type": "array", "items": { "type": "string" } },
        "authentication": { "type": "array", "items": { "type": "string" } },
        "credential_mode": { "type": ["string", "null"] },
        "request_body_shape": { "type": ["string", "null"] },
        "response_clues": { "type": "array", "items": { "type": "string" } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "graphqlOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "endpoint_id",
        "operation_type",
        "operation_name",
        "document_or_hash",
        "variables",
        "authentication",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string" },
        "endpoint_id": { "type": ["string", "null"] },
        "operation_type": {
          "type": "string",
          "enum": ["query", "mutation", "subscription", "unknown"]
        },
        "operation_name": { "type": ["string", "null"] },
        "document_or_hash": { "type": ["string", "null"] },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "authentication": { "type": "array", "items": { "type": "string" } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "realtimeChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "transport",
        "url",
        "protocols",
        "authentication",
        "events",
        "parameters",
        "confidence",
        "evidence_ids",
        "notes"
      ],
      "properties": {
        "id": { "type": "string" },
        "transport": {
          "type": "string",
          "enum": ["websocket", "socket_io", "sse", "broadcast_channel", "message_channel", "shared_worker", "other"]
        },
        "url": { "type": ["string", "null"] },
        "protocols": { "type": "array", "items": { "type": "string" } },
        "authentication": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
